generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  password             String
  firstName            String?            @map("first_name")
  lastName             String?            @map("last_name")
  phone                String?
  role                 UserRole           @default(USER)
  isEmailVerified      Boolean            @default(false) @map("is_email_verified")
  emailVerifiedAt      DateTime?          @map("email_verified_at")
  kycStatus            KycStatus          @default(NOT_STARTED) @map("kyc_status")
  kycSubmittedAt       DateTime?          @map("kyc_submitted_at")
  kycApprovedAt        DateTime?          @map("kyc_approved_at")
  walletAddress        String?            @unique @map("wallet_address")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  kycExpiresAt         DateTime?          @map("kyc_expires_at")
  verificationLevel    VerificationLevel? @map("verification_level")
  verificationExpires  DateTime?
  verificationToken    String?            @unique
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  kycBlockchainSynced  Boolean            @default(false) @map("kyc_blockchain_synced")
  kycBlockchainTxHash  String?            @map("kyc_blockchain_tx_hash")
  kycLastVerified      DateTime?          @map("kyc_last_verified")
  kycSyncAttempts      Int                @default(0) @map("kyc_sync_attempts")
  kycSyncError         String?            @map("kyc_sync_error")
  kycDocumentHash      String?
  bookings             Booking[]
  createdHotelAssets   HotelAsset[]       @relation("CreatedAssets")
  investments          Investment[]
  reviewedKyc          Kyc[]              @relation("ReviewedBy")
  kyc                  Kyc?
  createdProposals     Proposal[]         @relation("CreatedProposals")
  proposedProposals    Proposal[]         @relation("ProposerProposals")
  createdStakings      Staking[]          @relation("CreatedStaking")
  stakings             Staking[]          @relation("UserStakings")
  votes                Vote[]

  @@index([email])
  @@index([walletAddress])
  @@index([kycStatus])
  @@index([kycBlockchainSynced])
  @@map("users")
}

model Kyc {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  fullName           String    @map("full_name")
  dateOfBirth        DateTime  @map("date_of_birth")
  nationality        String
  city               String
  state              String
  postalCode         String    @map("postal_code")
  country            String
  rejectionReason    String?   @map("rejection_reason")
  submittedAt        DateTime  @default(now()) @map("submitted_at")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewedBy         String?   @map("reviewed_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  address            String
  documentNumber     String    @map("document_number")
  documentType       String    @map("document_type")
  status             KycStatus @default(PENDING)
  approvedAt         DateTime?
  blockchainTx       String?
  blockchainVerifier String?
  documentHash       String?
  expiresAt          DateTime?
  addressProof       String?   @map("address_proof")
  documentBack       String?   @map("document_back")
  documentFront      String?   @map("document_front")
  selfieImage        String?   @map("selfie_image")
  reviewer           User?     @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewedBy])
  @@map("kyc")
}

model HotelAsset {
  id            String       @id @default(uuid())
  name          String
  location      String
  status        AssetStatus  @default(UPCOMING)
  description   String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  createdById   String       @map("created_by_id")
  apy           Float?
  country       String?
  createdBy     String?      @map("created_by")
  esgScore      Int?         @map("esg_score")
  imageUrl      String?      @map("image_url")
  isSample      Boolean?     @map("is_sample")
  leaseEndDate  DateTime?    @map("lease_end_date")
  occupancyRate Float?       @map("occupancy_rate")
  revpar        Int?
  roomCount     Int?         @map("room_count")
  starRating    Int?         @map("star_rating")
  tokenPrice    Int?         @map("token_price")
  tokenSymbol   String?      @map("token_symbol")
  tokensSold    Int?         @map("tokens_sold")
  totalTokens   Int?         @map("total_tokens")
  totalValue    Int?         @map("total_value")
  tokenId       Int?         @unique
  tokenAddress  String?      @unique(map: "unique_token_address") @map("token_address")
  blockchainId  Int?         @unique @map("blockchain_id")
  bookings      Booking[]
  createdByUser User         @relation("CreatedAssets", fields: [createdById], references: [id])
  investments   Investment[]
  proposals     Proposal[]

  @@map("hotel_assets")
}

model Investment {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  hotelAssetId     String           @map("hotel_asset_id")
  transactionHash  String?          @map("transaction_hash")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  status           InvestmentStatus @default(PENDING)
  amount           Decimal?         @map("amount") @db.Decimal(10, 2)
  createdBy        String?          @map("created_by")
  createdById      String?          @map("created_by_id")
  earnedRewards    Decimal          @map("earned_rewards") @db.Decimal(10, 2)
  investedAmount   Decimal          @map("invested_amount") @db.Decimal(10, 2)
  platformFee      Decimal          @default(0) @map("platform_fee") @db.Decimal(10, 2)
  isSample         Boolean          @default(false) @map("is_sample")
  pendingRewards   Decimal          @map("pending_rewards") @db.Decimal(10, 2)
  stakedAmount     Decimal          @map("staked_amount") @db.Decimal(10, 2)
  tokenAmount      Decimal          @map("token_amount") @db.Decimal(18, 8)
  blockchainStatus String?          @default("PENDING")
  blockchainTxHash String?          @map("blockchain_tx_hash")
  deletedAt        DateTime?        @map("deleted_at")
  walletAddress    String?
  blockchainError  String?
  hotelAsset       HotelAsset       @relation(fields: [hotelAssetId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hotelAssetId])
  @@index([transactionHash])
  @@index([status])
  @@index([blockchainStatus])
  @@map("investments")
}

model Booking {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  hotelAssetId    String        @map("hotel_asset_id")
  checkInDate     DateTime      @map("check_in_date")
  checkOutDate    DateTime      @map("check_out_date")
  guests          Int
  roomType        String        @map("room_type")
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  specialRequests String?       @map("special_requests")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  bookingCode     String?       @map("booking_code")
  discountApplied Int?          @map("discount_applied")
  paymentMethod   String?       @map("payment_method")
  hotelAsset      HotelAsset    @relation(fields: [hotelAssetId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hotelAssetId])
  @@index([status])
  @@map("bookings")
}

model Proposal {
  id                String            @id @default(uuid())
  title             String
  description       String
  type              ProposalType
  proposerId        String            @map("proposer_id")
  hotelAssetId      String?           @map("hotel_asset_id")
  status            ProposalStatus    @default(DRAFT)
  votingStartDate   DateTime?         @map("voting_start_date")
  votingEndDate     DateTime?         @map("voting_end_date")
  votesFor          Int               @default(0) @map("votes_for")
  votesAgainst      Int               @default(0) @map("votes_against")
  votesAbstain      Int               @default(0) @map("votes_abstain")
  quorumRequired    Int               @map("quorum_required")
  approvalThreshold Int               @map("approval_threshold")
  executionDetails  String?           @map("execution_details")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  createdById       String            @map("created_by_id")
  category          ProposalCategory?
  createdBy         User              @relation("CreatedProposals", fields: [createdById], references: [id])
  hotelAsset        HotelAsset?       @relation(fields: [hotelAssetId], references: [id])
  proposer          User              @relation("ProposerProposals", fields: [proposerId], references: [id])
  votes             Vote[]

  @@index([proposerId])
  @@index([hotelAssetId])
  @@index([status])
  @@map("proposals")
}

model Vote {
  id          String     @id @default(uuid())
  proposalId  String     @map("proposal_id")
  userId      String     @map("user_id")
  choice      VoteChoice
  votingPower Int        @map("voting_power")
  comment     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  proposal    Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@index([userId])
  @@map("votes")
}

model Staking {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  stakedAmount          Float         @map("staked_amount")
  lockPeriodDays        Int           @map("lock_period_days")
  stakeStartDate        DateTime      @map("stake_start_date")
  stakeEndDate          DateTime      @map("stake_end_date")
  apyRate               Float         @map("apy_rate")
  earnedRewards         Float         @default(0) @map("earned_rewards")
  claimedRewards        Float         @default(0) @map("claimed_rewards")
  votingPowerMultiplier Float         @default(1) @map("voting_power_multiplier")
  status                StakingStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  createdById           String        @map("created_by_id")
  isSample              Boolean       @default(false) @map("is_sample")
  createdBy             User          @relation("CreatedStaking", fields: [createdById], references: [id])
  user                  User          @relation("UserStakings", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("staking")
}

model EsgReward {
  id            String          @id @default(uuid())
  user_email    String
  action_type   ESGActionType
  reward_amount Float
  status        ESGRewardStatus @default(pending)
  created_date  DateTime        @default(now())
  updated_at    DateTime        @updatedAt
}

enum ESGRewardStatus {
  pending
  verified
  claimed
}

enum ESGActionType {
  ac_off
  towel_reuse
  no_cleaning
  water_saving
  recycling
}

enum StakingStatus {
  ACTIVE
  UNSTAKED
  REWARDED
  CLOSED
}

enum UserRole {
  USER
  ADMIN
  PROPERTY_MANAGER
  COMPLIANCE_OFFICER
  FINANCE_MANAGER
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  EXPIRED
}

enum VerificationLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  FULL
}

enum DocumentType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  RESIDENCE_PERMIT
}

enum AssetStatus {
  UPCOMING
  ACTIVE
  SOLD_OUT
  CLOSED
  FUNDRAISING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ProposalStatus {
  DRAFT
  ACTIVE
  APPROVED
  REJECTED
  EXECUTED
}

enum ProposalType {
  RENOVATION
  EXPANSION
  POLICY_CHANGE
  DIVIDEND_DISTRIBUTION
  OTHER
}

enum ProposalCategory {
  asset_acquisition
  fee_adjustment
  partnership
  platform_upgrade
  esg_initiative
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  ACTIVE
  DELETED
}
