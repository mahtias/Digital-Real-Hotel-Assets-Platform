pragma solidity ^0.8.24;

import "forge-std/Script.sol";
import "forge-std/console.sol";
import "../contracts/MockUSDC.sol";
import "../contracts/KYCRegistry.sol";
import "../contracts/HATToken.sol";
import "../contracts/HotelAssetManager.sol";
import "../contracts/Investment.sol";

contract DeployAll is Script {
    function run() external {
        uint256 pk = vm.envUint("PRIVATE_KEY");
        address deployer = vm.addr(pk);

        console.log("==========================================");
        console.log("Deploying All Contracts");
        console.log("Deployer:", deployer);
        console.log("==========================================\n");

        vm.startBroadcast(pk);

        // 1. Deploy MockUSDC
        console.log("[1/5] Deploying MockUSDC...");
        MockUSDC usdc = new MockUSDC();
        console.log("  MockUSDC:", address(usdc));

        // 2. Deploy KYCRegistry
        console.log("\n[2/5] Deploying KYCRegistry...");
        KYCRegistry kycRegistry = new KYCRegistry(deployer);
        console.log("  KYCRegistry:", address(kycRegistry));

        // 3. Deploy HATToken
        console.log("\n[3/5] Deploying HATToken...");
        HATToken hatToken = new HATToken();
        console.log("  HATToken:", address(hatToken));

        // 4. Deploy HotelAssetManager
        console.log("\n[4/5] Deploying HotelAssetManager...");
        HotelAssetManager assetManager = new HotelAssetManager(address(hatToken));
        console.log("  HotelAssetManager:", address(assetManager));

        // 5. Deploy Investment
        console.log("\n[5/5] Deploying Investment...");
        Investment investment = new Investment(
            address(usdc),
            address(kycRegistry),
            address(assetManager),
            deployer // treasury
        );
        console.log("  Investment:", address(investment));

        //  FIXED: Grant MANAGER_ROLE to assetManager
        console.log("\n[Setup] Granting roles...");
        bytes32 MANAGER_ROLE = keccak256("MANAGER_ROLE");
        hatToken.grantRole(MANAGER_ROLE, address(assetManager));
        console.log("  Granted MANAGER_ROLE to HotelAssetManager");

        // Link investment contract to asset manager
        assetManager.setInvestmentContract(address(investment));
        console.log("  Linked Investment to HotelAssetManager");

        vm.stopBroadcast();

        // Print summary
        console.log("\n==========================================");
        console.log("Deployment Summary");
        console.log("==========================================");
        console.log("MockUSDC:              ", address(usdc));
        console.log("KYCRegistry:           ", address(kycRegistry));
        console.log("HATToken:              ", address(hatToken));
        console.log("HotelAssetManager:     ", address(assetManager));
        console.log("Investment:            ", address(investment));
        console.log("Treasury (Deployer):   ", deployer);
        console.log("==========================================\n");

        // Print role verification
        console.log("Role Verification:");
        console.log("-------------------------------------------");
        console.log("HATToken MANAGER_ROLE holder:    ", address(assetManager));
        console.log("AssetManager has MANAGER_ROLE:   ", hatToken.hasRole(MANAGER_ROLE, address(assetManager)));
        console.log("==========================================\n");
    }
}
